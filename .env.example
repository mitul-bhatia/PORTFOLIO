# Site URL (for SEO, sitemap, canonicals, and metadata)
SITE_URL=https://mitulb95.dev
NEXT_PUBLIC_SITE_URL=https://mitulb95.dev

# Google Search Console Verification code (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# AI Concierge Model Configuration
# Server environment variables only. NEVER expose to client bundle.
NOTEBOOK_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Bearer token for GET /api/news/refresh. On Vercel, CRON_SECRET is sent automatically.
NEWS_REFRESH_SECRET=
